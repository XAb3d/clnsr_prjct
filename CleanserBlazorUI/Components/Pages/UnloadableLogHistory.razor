@page "/unloadable-log-history"
@rendermode InteractiveServer
@inject DataManagementService DataManagementService

@attribute [Authorize(Roles = "admin")]

<MudAlert Class="@AlertSeverityVisible" Severity="@AlertSeverity">@AlertSeverityMessage</MudAlert>

<MudText Typo="Typo.h5" Class="mb-4">Unloadable Log History</MudText>

<MudGrid Class="mb-4">
    <MudItem xs="12" sm="4" md="3">
        <MudSelect T="string" Label="Year" Value="selectedYear" ValueChanged="OnYearChanged" Clearable="true">
            @foreach (var year in availableYears)
            {
                <MudSelectItem T="string" Value="@year">@year</MudSelectItem>
            }
        </MudSelect>
    </MudItem>
    <MudItem xs="12" sm="4" md="3">
        <MudSelect T="string" Label="File Type" Value="selectedDataType" ValueChanged="OnDataTypeChanged" Clearable="true">
            <MudSelectItem T="string" Value="@("IND")">Individual</MudSelectItem>
            <MudSelectItem T="string" Value="@("BUS")">Business</MudSelectItem>
        </MudSelect>
    </MudItem>
    <MudItem xs="12" sm="4" md="4">
        <MudSelect T="int?" Label="Subscriber" Value="selectedSubscriberId" ValueChanged="OnSubscriberChanged" Clearable="true">
            @foreach (var profile in subscriberProfiles)
            {
                <MudSelectItem T="int?" Value="@profile.Id">@profile.SubscriberName (@profile.SubscriberCode)</MudSelectItem>
            }
        </MudSelect>
    </MudItem>
    <MudItem xs="12" sm="12" md="2" Class="d-flex align-center">
        <MudButton Variant="Variant.Outlined" FullWidth="true" OnClick="ClearFiltersAsync">Clear Filters</MudButton>
    </MudItem>
</MudGrid>

<MudDataGrid T="UnloadableLogHeader" Items="@logs" Loading="@isLoading" ReadOnly="false"
             EditMode="DataGridEditMode.Cell" EditTrigger="DataGridEditTrigger.OnRowClick"
             CommittedItemChanges="OnCommittedItemChanges"
             Filterable="true" SortMode="SortMode.Multiple" Bordered="true" Striped="true" Dense="true">
    <Columns>
        <PropertyColumn Property="x => x.SubscriberProfile!.SubscriberName" Title="Subscriber" ReadOnly="true">
            <CellTemplate>@context.Item.SubscriberProfile?.SubscriberName</CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.SubscriberProfile!.SubscriberCode" Title="Subcode" ReadOnly="true">
            <CellTemplate>@context.Item.SubscriberProfile?.SubscriberCode</CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.DataType" Title="Type" ReadOnly="true">
            <CellTemplate>@context.Item.DataType</CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.Filename" Title="Filename" ReadOnly="true">
            <CellTemplate>@context.Item.Filename</CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.ReportingPeriod" Title="Reporting Period" ReadOnly="true">
            <CellTemplate>@context.Item.ReportingPeriod</CellTemplate>
        </PropertyColumn>
        @* Explicit CellTemplate-only (no EditTemplate) here specifically because
           ReadOnly="true" alone was not enough to stop this int column from
           rendering a numeric up/down spinner and saving on every click --
           NumberOfRecords is an immutable snapshot of the run and should never
           be user-editable. *@
        <PropertyColumn Property="x => x.NumberOfRecords" Title="# UNL Records" ReadOnly="true">
            <CellTemplate>@context.Item.NumberOfRecords</CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.CreatedDate" Title="Generated On" ReadOnly="true">
            <CellTemplate>@context.Item.CreatedDate.ToString("dd MMM yyyy HH:mm")</CellTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x => x.DateEmailed" Title="Date Emailed">
            <CellTemplate>
                @(context.Item.DateEmailed?.ToString("dd MMM yyyy") ?? "—")
            </CellTemplate>
            <EditTemplate>
                <MudDatePicker @bind-Date="context.Item.DateEmailed" Editable="true" />
            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x => x.DateFixed" Title="Date Fixed">
            <CellTemplate>
                @(context.Item.DateFixed?.ToString("dd MMM yyyy") ?? "—")
            </CellTemplate>
            <EditTemplate>
                <MudDatePicker @bind-Date="context.Item.DateFixed" Editable="true" />
            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x => x.Comments" Title="Comments">
            <EditTemplate>
                <MudTextField @bind-Value="context.Item.Comments" Lines="2" />
            </EditTemplate>
        </PropertyColumn>
    </Columns>
    <PagerContent>
        <MudDataGridPager T="UnloadableLogHeader" PageSizeOptions="new[] { 25, 50, 100 }" />
    </PagerContent>
    <NoRecordsContent>
        <MudText>No log entries match the current filters.</MudText>
    </NoRecordsContent>
</MudDataGrid>

@code {
    private MudBlazor.Severity AlertSeverity { get; set; } = MudBlazor.Severity.Success;
    private string AlertSeverityVisible = "d-none";
    private string AlertSeverityMessage = string.Empty;

    private List<UnloadableLogHeader> logs = new();
    private List<SubscriberProfile> subscriberProfiles = new();
    private List<string> availableYears = new();
    private bool isLoading = true;

    private string? selectedYear;
    private string? selectedDataType;
    private int? selectedSubscriberId;

    protected override async Task OnInitializedAsync()
    {
        subscriberProfiles = await DataManagementService.GetAllSubscriberProfilesAsync();
        availableYears = await DataManagementService.GetUnloadableLogYearsAsync();
        // Default to the current year so the grid isn't dumping every run
        // across every year on first load -- clear it via "Clear Filters"
        // to see everything.
        selectedYear = DateTime.Now.Year.ToString();
        await ApplyFiltersAsync();
    }

    private async Task OnYearChanged(string value)
    {
        selectedYear = value;
        await ApplyFiltersAsync();
    }

    private async Task OnDataTypeChanged(string value)
    {
        selectedDataType = value;
        await ApplyFiltersAsync();
    }

    private async Task OnSubscriberChanged(int? value)
    {
        selectedSubscriberId = value;
        await ApplyFiltersAsync();
    }

    private async Task ApplyFiltersAsync()
    {
        isLoading = true;
        StateHasChanged();
        logs = await DataManagementService.GetUnloadableLogHeadersAsync(selectedYear, selectedDataType, selectedSubscriberId);
        isLoading = false;
        StateHasChanged();
    }

    private async Task ClearFiltersAsync()
    {
        selectedYear = null;
        selectedDataType = null;
        selectedSubscriberId = null;
        await ApplyFiltersAsync();
    }

    private async Task OnCommittedItemChanges(UnloadableLogHeader item)
    {
        try
        {
            await DataManagementService.UpdateUnloadableLogAsync(item);
            AlertSeverityMessage = $"Saved changes for {item.Filename}.";
            AlertSeverity = MudBlazor.Severity.Success;
        }
        catch (Exception ex)
        {
            AlertSeverityMessage = $"Could not save changes: {ex.Message}";
            AlertSeverity = MudBlazor.Severity.Error;
        }
        AlertSeverityVisible = "d-block";
        StateHasChanged();
    }
}
